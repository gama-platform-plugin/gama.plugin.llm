Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: WebRTC display for GAMA
Bundle-SymbolicName: gama.ui.display.webrtc;singleton:=true
Bundle-Version: 0.0.0.qualifier
Require-Bundle: gama.dependencies,
 gama.core,
 org.eclipse.ui,
 gama.ui.shared,
 gama.ui.experiment,
 gama.ui.display.opengl,
 gama.ui.display.opengl4
Bundle-ActivationPolicy: lazy
Bundle-Activator: gama.ui.display.webrtc.WebRTCActivator
Bundle-ClassPath: .,
 lib/webrtc-java-0.14.0.jar,
 lib/webrtc-java-0.14.0-macos-aarch64.jar,
 lib/webrtc-java-0.14.0-macos-x86_64.jar,
 lib/webrtc-java-0.14.0-windows-x86_64.jar,
 lib/webrtc-java-0.14.0-linux-x86_64.jar,
 lib/gson-2.10.1.jar
Import-Package: gama.extension.image,
 javax.imageio,
 org.java_websocket,
 org.java_websocket.handshake,
 org.java_websocket.server,
 org.locationtech.jts.geom
Export-Package: gama.ui.display.webrtc,
 gama.ui.display.webrtc.view
Bundle-Vendor: UMMISCO
Bundle-RequiredExecutionEnvironment: JavaSE-25
Automatic-Module-Name: gama.ui.display.webrtc
